@model IEnumerable<EjemploMVC.Models.Product>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark m-0">Productos</h1>
            <p class="text-muted m-0">Administra el inventario de la tienda en tiempo real.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Nuevo Producto
        </a>
    </div>

    <div class="card p-3 shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Precio)</th>
                        <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th>@Html.DisplayNameFor(model => model.Stock)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                No hay productos registrados aún.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Nombre</div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@item.Precio.ToString("C2")</span>
                                </td>
                                <td>
                                    <span class="text-secondary text-truncate d-inline-block" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" : item.Descripcion)
                                    </span>
                                </td>
                                <td>
                                    @if (item.Stock == 0)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1.5">
                                            Agotado
                                        </span>
                                    }
                                    else if (item.Stock <= 5)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-2.5 py-1.5">
                                            Bajo Stock (@item.Stock)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1.5">
                                            @item.Stock unidades
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" title="Editar">
                                            <i class="bi bi-pencil"></i> <span class="d-none d-md-inline">Editar</span>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1" title="Detalles">
                                            <i class="bi bi-eye"></i> <span class="d-none d-md-inline">Ver</span>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" title="Eliminar">
                                            <i class="bi bi-trash"></i> <span class="d-none d-md-inline">Eliminar</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
