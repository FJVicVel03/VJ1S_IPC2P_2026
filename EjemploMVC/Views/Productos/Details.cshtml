@model EjemploMVC.Models.Product

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="animate-fade-in" style="max-width: 650px; margin: 0 auto;">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-1 text-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
        <h1 class="fw-bold text-dark mt-2">Detalles del Producto</h1>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                    <i class="bi bi-box-seam fs-2"></i>
                </div>
                <div>
                    <h2 class="h4 fw-bold m-0 text-dark">@Model.Nombre</h2>
                    <span class="text-muted small">ID de Producto: #@Model.Id</span>
                </div>
            </div>

            <hr class="border-light mb-4" />

            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <div class="text-secondary small">Precio de Venta</div>
                    <div class="fs-3 fw-bold text-primary">@Model.Precio.ToString("C2")</div>
                </div>

                <div class="col-sm-6">
                    <div class="text-secondary small mb-1">Disponibilidad en Almacén</div>
                    <div>
                        @if (Model.Stock == 0)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-exclamation-circle-fill me-1"></i> Agotado
                            </span>
                        }
                        else if (Model.Stock <= 5)
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Bajo Stock (@Model.Stock)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> @Model.Stock unidades disponibles
                            </span>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="text-secondary small mb-1">Descripción del Producto</div>
                    <div class="p-3 bg-light rounded-3 text-dark border border-light-subtle" style="white-space: pre-wrap;">
                        @(string.IsNullOrEmpty(Model.Descripcion) ? "No se ha proporcionado una descripción para este producto." : Model.Descripcion)
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end border-top pt-4">
                <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-fill"></i> Editar Detalles
                </a>
            </div>
        </div>
    </div>
</div>
