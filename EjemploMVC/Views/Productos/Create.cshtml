@model EjemploMVC.Models.Product

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="animate-fade-in" style="max-width: 600px; margin: 0 auto;">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-1 text-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
        <h1 class="fw-bold text-dark mt-2">Agregar Producto</h1>
        <p class="text-muted">Introduce los detalles del nuevo producto para añadirlo al inventario.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Monitor Gamer ASUS" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Precio" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label fw-semibold"></label>
                        <input asp-for="Stock" class="form-control" type="number" placeholder="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Breve descripción del artículo..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
