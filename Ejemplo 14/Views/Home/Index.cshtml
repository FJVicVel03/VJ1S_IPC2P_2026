@model Ejemplo_14.Models.DashboardViewModel
@{
    ViewData["Title"] = "Ejemplo 14 - Enrutamiento Lógico de Saltos Ortogonales (DFS)";
}

<div class="container py-4">
    <!-- Encabezado Principal -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">OrbitNet - Ejemplo 14</h1>
        <p class="lead text-muted">Enrutamiento Lógico por DFS y Resaltado en Graphviz sobre Matriz Dispersa Ortogonal</p>
        <div class="badge bg-secondary px-3 py-2">Estado: Simulacion en Memoria RAM Activa</div>
    </div>

    <!-- Alertas de Retroalimentacion -->
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Fila 1: Carga Masiva y Recursos de Prueba -->
    <div class="row g-4 mb-5">
        <!-- Carga Masiva XML -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-file-earmark-code-fill me-2"></i>Carga XML Transaccional (Matriz y AVL)</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <p class="text-muted small">
                        Suba el archivo XML. Si algun elemento (ecuatorial, polar o antena) no cumple con Regex o genera colision, la carga completa se abortara (Rollback) para mantener la consistencia de la memoria.
                    </p>
                    <form asp-controller="Xml" asp-action="CargarXml" method="post" enctype="multipart/form-data" class="mt-3">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">Seleccionar archivo XML</label>
                            <input type="file" name="archivoXml" class="form-control" accept=".xml" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-shield-check me-2"></i>Iniciar Ingesta Masiva Transaccional
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Recursos y Purgas -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-gear-fill me-2"></i>Administracion de Datos</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <p class="text-muted small">Descargue archivos de prueba oficiales con constelaciones y antenas terrestres:</p>
                        <div class="d-flex gap-2 flex-column">
                            <a href="~/datos_completos.xml" download class="btn btn-outline-success text-start w-100">
                                <i class="bi bi-file-earmark-check-fill me-2 text-success"></i>Descargar datos_completos.xml (Commit)
                            </a>
                            <a href="~/datos_completos_invalidos.xml" download class="btn btn-outline-warning text-start w-100">
                                <i class="bi bi-file-earmark-x-fill me-2 text-warning"></i>Descargar datos_completos_invalidos.xml (Rollback)
                            </a>
                            <a href="~/datos_pruebas_enrutamiento.xml" download class="btn btn-outline-info text-start w-100">
                                <i class="bi bi-file-earmark-code-fill me-2 text-info"></i>Descargar datos_pruebas_enrutamiento.xml (Malla Completa)
                            </a>
                        </div>
                        <div class="mt-3">
                            <p class="text-muted small mb-1">Consultar Endpoints de la API REST (JSON):</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/api/satelites" target="_blank" class="btn btn-outline-info btn-sm flex-grow-1 text-start">
                                    <i class="bi bi-braces me-1"></i>GET /api/satelites (Pub)
                                </a>
                                <a href="/api/seguro/satelites" target="_blank" class="btn btn-outline-warning btn-sm flex-grow-1 text-start">
                                    <i class="bi bi-shield-lock me-1"></i>GET /api/seguro/satelites (Sec)
                                </a>
                                <a href="/api/logs" target="_blank" class="btn btn-outline-info btn-sm flex-grow-1 text-start">
                                    <i class="bi bi-braces me-1"></i>GET /api/logs
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <form asp-controller="Satelite" asp-action="LimpiarMatriz" method="post" class="flex-grow-1">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-trash-fill me-2"></i>Purgar Todo (Matriz e AVL)
                            </button>
                        </form>
                        <form asp-controller="Logs" asp-action="LimpiarLogs" method="post" class="flex-grow-1">
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-journal-x me-2"></i>Purgar Logs
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2: Insercion Manual, Eliminacion y Consola -->
    <div class="row g-4 mb-5">
        <!-- Controles Manuales -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-plus-circle-fill me-2"></i>Insertar en Matriz Dispersa</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Satelite" asp-action="InsertarNodo" method="post">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Fila (Latitud / Y)</label>
                                <input type="number" name="row" class="form-control" min="-90" max="90" placeholder="15" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Columna (Longitud / X)</label>
                                <input type="number" name="col" class="form-control" min="-180" max="180" placeholder="-91" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">ID de Satelite / Antena</label>
                            <input type="text" name="id" class="form-control font-monospace text-uppercase" placeholder="ANT-GTM-401" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Nombre</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Estacion Central USAC" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Direccion IP (IPv4)</label>
                            <input type="text" name="ip" class="form-control font-monospace" placeholder="10.0.0.50" required />
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-secondary">
                                <i class="bi bi-plus-lg me-2"></i>Insertar en Matriz
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-trash-fill me-2"></i>Eliminar de Matriz Dispersa</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Satelite" asp-action="EliminarNodo" method="post">
                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-4">
                                <label class="form-label fw-semibold text-secondary small">Fila (Y)</label>
                                <input type="number" name="row" class="form-control" min="-90" max="90" required />
                            </div>
                            <div class="col-4">
                                <label class="form-label fw-semibold text-secondary small">Col (X)</label>
                                <input type="number" name="col" class="form-control" min="-180" max="180" required />
                            </div>
                            <div class="col-4 d-grid">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-x-lg me-2"></i>Borrar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Cliente HTTP (Consumidor REST) -->
            <div class="card shadow-sm border-0 rounded-3 mt-4">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-send-fill me-2"></i>Cliente HTTP (Consumidor REST)</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="HttpCliente" asp-action="ConsultarApi" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">URL del Endpoint API</label>
                            <input type="url" name="urlDestino" class="form-control font-monospace" value="http://localhost:5024/api/seguro/satelites" placeholder="http://localhost:5024/api/seguro/satelites" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Usuario REST (Opcional)</label>
                                <input type="text" name="usuario" class="form-control font-monospace" placeholder="orbitnet_admin" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Contraseña REST (Opcional)</label>
                                <input type="password" name="contrasena" class="form-control font-monospace" placeholder="USAC_ECYS_2026" />
                            </div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-info text-white">
                                <i class="bi bi-cloud-arrow-down-fill me-2"></i>Consultar Endpoint
                            </button>
                        </div>
                    </form>

                    @if (ViewBag.ResultadoHttp != null)
                    {
                        <div class="mt-4">
                            <label class="form-label fw-semibold text-secondary small">Respuesta Cruda (JSON):</label>
                            <pre class="bg-dark text-light p-3 rounded font-monospace small" style="max-height: 200px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;">@ViewBag.ResultadoHttp</pre>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Consola de Auditoria -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-terminal-fill me-2"></i>Consola de Auditoria (TDA LogAuditoria)</h5>
                    <span class="badge bg-light text-dark rounded-pill px-3">@Model.Logs.Tamano eventos</span>
                </div>
                <div class="card-body p-3 bg-light">
                    @if (Model.Logs.EstaVacia)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-journal-text display-6 text-secondary mb-2 d-block"></i>
                            <p class="mb-0 small">Bitacora de auditoria vacia.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 440px; overflow-y: auto; font-family: 'JetBrains Mono', 'Consolas', monospace; font-size: 0.8rem;">
                            <table class="table table-hover align-middle bg-white mb-0 rounded-2 overflow-hidden shadow-sm">
                                <thead class="table-dark fs-7">
                                    <tr>
                                        <th scope="col" class="px-3 py-2.5">Timestamp</th>
                                        <th scope="col" class="py-2.5">Tipo</th>
                                        <th scope="col" class="py-2.5">Mensaje de Auditoria</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.Logs.ObtenerTodos())
                                    {
                                        var filaClase = log.Tipo == "ERROR" ? "table-danger" : (log.Tipo == "ALERT" ? "table-warning" : "");
                                        var badgeClase = log.Tipo == "ERROR" ? "bg-danger" : (log.Tipo == "ALERT" ? "bg-warning" : "bg-success");
                                        <tr class="@filaClase">
                                            <td class="px-3 py-2 text-muted" style="white-space: nowrap;">@log.Timestamp</td>
                                            <td class="py-2"><span class="badge @badgeClase text-white">@log.Tipo</span></td>
                                            <td class="py-2 text-dark font-monospace">@log.Mensaje</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 3: Gestion de Buffer Satelital (ABB como Cola de Prioridad) -->
    <div class="row g-4 mb-5">
        <!-- Panel de Control de Buffer -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-box-seam me-2"></i>Controles del Buffer (AbbNode)</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Dropdown de seleccion de satelite -->
                        <form method="get" action="@Url.Action("Index", "Home")" class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Seleccionar Satélite para Inspeccionar</label>
                            <select name="sateliteId" class="form-select font-monospace" onchange="this.form.submit()">
                                <option value="">-- Seleccionar Satélite --</option>
                                @foreach (var sat in Model.Matriz.ObtenerTodosLosNodos())
                                {
                                    if (sat.Id == ViewBag.SateliteSeleccionado)
                                    {
                                        <option value="@sat.Id" selected>@sat.Nombre (@sat.Id)</option>
                                    }
                                    else
                                    {
                                        <option value="@sat.Id">@sat.Nombre (@sat.Id)</option>
                                    }
                                }
                            </select>
                        </form>

                        <hr />

                        <!-- Formulario de Encolar -->
                        <form asp-controller="Buffer" asp-action="Encolar" method="post" class="mt-3">
                            <input type="hidden" name="sateliteId" value="@ViewBag.SateliteSeleccionado" />
                            <input type="hidden" name="emisorId" value="@ViewBag.SateliteSeleccionado" />

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary small">Código Paquete</label>
                                    <input type="text" name="hexCode" class="form-control font-monospace" placeholder="PKT-A1" required @(string.IsNullOrEmpty(ViewBag.SateliteSeleccionado) ? "disabled" : "") />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold text-secondary small">IP Destino</label>
                                    <input type="text" name="destIp" class="form-control font-monospace" placeholder="10.0.0.50" required @(string.IsNullOrEmpty(ViewBag.SateliteSeleccionado) ? "disabled" : "") />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Prioridad (1-5)</label>
                                <select name="priority" class="form-select font-monospace" required @(string.IsNullOrEmpty(ViewBag.SateliteSeleccionado) ? "disabled" : "")>
                                    <option value="1">1 - Baja</option>
                                    <option value="2">2 - Normal</option>
                                    <option value="3">3 - Media</option>
                                    <option value="4">4 - Alta</option>
                                    <option value="5" selected>5 - Alerta Crítica</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Contenido</label>
                                <textarea name="content" class="form-control" rows="2" placeholder="Cuerpo del mensaje..." required @(string.IsNullOrEmpty(ViewBag.SateliteSeleccionado) ? "disabled" : "")></textarea>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary" @(string.IsNullOrEmpty(ViewBag.SateliteSeleccionado) ? "disabled" : "")>
                                    <i class="bi bi-box-arrow-in-down me-2"></i>Encolar Mensaje (ABB)
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Boton de Desencolar -->
                    <form asp-controller="Buffer" asp-action="Desencolar" method="post" class="mt-4 pt-3 border-top">
                        <input type="hidden" name="sateliteId" value="@ViewBag.SateliteSeleccionado" />
                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger" @(string.IsNullOrEmpty(ViewBag.SateliteSeleccionado) ? "disabled" : "")>
                                <i class="bi bi-box-arrow-up me-2"></i>Desencolar Máxima Prioridad (Rightmost Node)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Visualizacion de Cola del Satelite Seleccionado -->
        <div class="col-md-7">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-list-columns-reverse me-2"></i>Cola de Prioridad Activa (Recorrido In-Order Inverso)</h5>
                    <span class="badge bg-light text-dark rounded-pill px-3">
                        @{
                            int conteoMsg = 0;
                            if (!string.IsNullOrEmpty(ViewBag.SateliteSeleccionado))
                            {
                                foreach (var sat in Model.Matriz.ObtenerTodosLosNodos())
                                {
                                    if (sat.Id == ViewBag.SateliteSeleccionado)
                                    {
                                        conteoMsg = sat.Buffer.Count;
                                        break;
                                    }
                                }
                            }
                        }
                        @conteoMsg mensajes
                    </span>
                </div>
                <div class="card-body p-3 bg-light">
                    @{
                        Ejemplo_14.Models.MatrixNode? SateliteSeleccionadoObj = null;
                        if (!string.IsNullOrEmpty(ViewBag.SateliteSeleccionado))
                        {
                            foreach (var sat in Model.Matriz.ObtenerTodosLosNodos())
                            {
                                if (sat.Id == ViewBag.SateliteSeleccionado)
                                {
                                    SateliteSeleccionadoObj = sat;
                                    break;
                                }
                            }
                        }
                    }

                    @if (SateliteSeleccionadoObj == null)
                    {
                        <div class="text-center py-5 my-5 text-muted">
                            <i class="bi bi-hdd-network display-5 text-secondary mb-3 d-block"></i>
                            <p class="mb-0">Seleccione un satélite del panel izquierdo para visualizar su cola de prioridad ABB en tiempo real.</p>
                        </div>
                    }
                    else
                    {
                        var mensajes = SateliteSeleccionadoObj.Buffer.ObtenerMensajesOrdenados();
                        if (mensajes.Length == 0)
                        {
                            <div class="text-center py-5 my-5 text-muted">
                                <i class="bi bi-envelope-open display-5 text-secondary mb-3 d-block"></i>
                                <p class="mb-0">El buffer de este satélite se encuentra vacío en este momento.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-hover align-middle bg-white mb-0 rounded-2 overflow-hidden shadow-sm">
                                    <thead class="table-dark fs-7">
                                        <tr>
                                            <th scope="col" class="px-3 py-2.5">Prioridad</th>
                                            <th scope="col" class="py-2.5">Código</th>
                                            <th scope="col" class="py-2.5">Origen</th>
                                            <th scope="col" class="py-2.5">IP Terrestre</th>
                                            <th scope="col" class="py-2.5">Mensaje</th>
                                        </tr>
                                    </thead>
                                    <tbody class="fs-7">
                                        @foreach (var msg in mensajes)
                                        {
                                            var filaColor = msg.Priority == 5 ? "table-danger" : (msg.Priority >= 3 ? "table-warning" : "");
                                            var badgeColor = msg.Priority == 5 ? "bg-danger" : (msg.Priority >= 3 ? "bg-warning" : "bg-success");
                                            <tr class="@filaColor">
                                                <td class="px-3 py-2"><span class="badge @badgeColor text-white">@msg.Priority</span></td>
                                                <td class="py-2 font-monospace fw-bold text-primary">@msg.HexCode</td>
                                                <td class="py-2 font-monospace">@msg.EmisorId</td>
                                                <td class="py-2 font-monospace">@msg.DestIp</td>
                                                <td class="py-2 text-dark">@msg.Content</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 3: Enrutamiento y Visualizacion de Memoria (Graphviz) -->
    <div class="row g-4 mb-5">
        <!-- Control de Enrutamiento -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-compass-fill me-2"></i>Enrutamiento de Red (Saltos Ortogonales)</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <p class="text-muted small">
                            Calcule la ruta física utilizando el algoritmo de backtracking por punteros directos (DFS) de la matriz dispersa.
                        </p>
                        
                        <!-- Formulario para Trazar -->
                        <form asp-controller="Route" asp-action="Trazar" method="post" class="mt-3">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Satélite / Antena Origen</label>
                                <select name="origenId" class="form-select font-monospace" required>
                                    <option value="">-- Seleccionar Origen --</option>
                                    @foreach (var sat in Model.Matriz.ObtenerTodosLosNodos())
                                    {
                                        <option value="@sat.Id">@sat.Nombre (@sat.Id)</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Satélite / Antena Destino</label>
                                <select name="destinoId" class="form-select font-monospace" required>
                                    <option value="">-- Seleccionar Destino --</option>
                                    @foreach (var sat in Model.Matriz.ObtenerTodosLosNodos())
                                    {
                                        <option value="@sat.Id">@sat.Nombre (@sat.Id)</option>
                                    }
                                </select>
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-bezier2 me-2"></i>Trazar Ruta Ortogonal
                                </button>
                            </div>
                        </form>

                        @if (MemoriaPlano.RutaActiva != null)
                        {
                            <form asp-controller="Route" asp-action="Limpiar" method="post" class="mt-2">
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="bi bi-x-circle me-2"></i>Limpiar Trazado
                                    </button>
                                </div>
                            </form>
                        }
                    </div>

                    <!-- Listado de Saltos (Si la ruta está activa) -->
                    @if (MemoriaPlano.RutaActiva != null && MemoriaPlano.RutaActiva.Length > 0)
                    {
                        <div class="mt-4 pt-3 border-top">
                            <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-signpost-split me-2"></i>Detalle de Saltos (@(MemoriaPlano.RutaActiva.Length - 1) saltos)</h6>
                            <div class="list-group list-group-flush border rounded overflow-hidden" style="max-height: 250px; overflow-y: auto;">
                                @for (int i = 0; i < MemoriaPlano.RutaActiva.Length; i++)
                                {
                                    var sat = MemoriaPlano.RutaActiva[i];
                                    <div class="list-group-item d-flex align-items-center py-2 px-3">
                                        <span class="badge bg-secondary me-2 font-monospace">#@(i + 1)</span>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark font-monospace small">@sat.Id</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@sat.Nombre (@sat.Row, @sat.Col)</div>
                                        </div>
                                        @if (i < MemoriaPlano.RutaActiva.Length - 1)
                                        {
                                            <i class="bi bi-arrow-down text-success fs-5"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-flag-fill text-danger fs-6"></i>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Diagrama SVG -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-diagram-3-fill me-2"></i>Estructura de Memoria Física (Map Memory Layout)</h5>
                </div>
                <div class="card-body p-4 bg-light text-center d-flex flex-column justify-content-between">
                    <p class="text-muted text-start small mb-3">Diagrama interactivo vectorial generado en caliente directamente desde los punteros `Up, Down, Left, Right` de la RAM (ruta activa pintada de verde):</p>
                    
                    <div class="border p-3 bg-white rounded overflow-auto shadow-sm flex-grow-1" style="max-height: 550px;">
                        @if (Model.Matriz.IsEmpty)
                        {
                            <div class="text-muted py-5 text-center">
                                <i class="bi bi-cpu-fill display-5 mb-3 d-block text-secondary"></i>
                                [Matriz Dispersa Vacía - Registre nodos para diagramar la memoria]
                            </div>
                        }
                        else
                        {
                            <div class="svg-container">
                                @Html.Raw(Model.SvgDiagrama)
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 4: Nodos Activos Matriz y Catalogo AVL -->
    <div class="row g-4">
        <!-- Nodos de la Matriz Dispersa -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-list-task me-2"></i>Nodos de Matriz Dispersa Activos</h5>
                    <span class="badge bg-light text-dark rounded-pill px-3">@Model.Matriz.Count nodos</span>
                </div>
                <div class="card-body p-3 bg-light">
                    @if (Model.Matriz.IsEmpty)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-hdd display-6 text-secondary mb-2 d-block"></i>
                            <p class="mb-0 small">No hay satelites ni antenas en la matriz dispersa.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-hover align-middle bg-white mb-0 rounded-2 overflow-hidden shadow-sm">
                                <thead class="table-dark fs-7">
                                    <tr>
                                        <th scope="col" class="px-3 py-2.5">Coordenadas (Y, X)</th>
                                        <th scope="col" class="py-2.5">Identificador</th>
                                        <th scope="col" class="py-2.5">Nombre</th>
                                        <th scope="col" class="py-2.5">Direccion IP</th>
                                    </tr>
                                </thead>
                                <tbody class="fs-7">
                                    @foreach (var sat in Model.Matriz.ObtenerTodosLosNodos())
                                    {
                                        <tr>
                                            <td class="px-3 py-2 font-monospace fw-bold text-secondary">(@sat.Row, @sat.Col)</td>
                                            <td class="py-2 font-monospace fw-bold text-primary">@sat.Id</td>
                                            <td class="py-2 fw-semibold text-dark">@sat.Nombre</td>
                                            <td class="py-2"><span class="badge bg-light text-dark border font-monospace">@sat.IpAddress</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Catalogo de Satelites Polares (Arbol AVL) -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-tree-fill me-2"></i>Catalogo AVL (Satelites Polares)</h5>
                    <span class="badge bg-light text-dark rounded-pill px-3">@Model.Catalogo.Conteo satelites</span>
                </div>
                <div class="card-body p-3 bg-light">
                    @if (Model.Catalogo.EstaVacio)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-diagram-2 display-6 text-secondary mb-2 d-block"></i>
                            <p class="mb-0 small">No hay satelites polares en el catalogo AVL.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-hover align-middle bg-white mb-0 rounded-2 overflow-hidden shadow-sm">
                                <thead class="table-dark fs-7">
                                    <tr>
                                        <th scope="col" class="px-3 py-2.5">ID Satelite</th>
                                        <th scope="col" class="py-2.5">Nombre</th>
                                        <th scope="col" class="py-2.5">Frecuencia</th>
                                    </tr>
                                </thead>
                                <tbody class="fs-7">
                                    @foreach (var polar in Model.Catalogo.ObtenerTodos())
                                    {
                                        <tr>
                                            <td class="px-3 py-2 font-monospace fw-bold text-primary">@polar.Id</td>
                                            <td class="py-2 fw-semibold text-dark">@polar.Nombre</td>
                                            <td class="py-2"><span class="badge bg-light text-dark border font-monospace">@polar.Frecuencia MHz</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


