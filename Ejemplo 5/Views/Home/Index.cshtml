@model Ejemplo_5.Models.DashboardViewModel
@{
    ViewData["Title"] = "Ejemplo 5 - Transaccionalidad RegEx";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <!-- Encabezado -->
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-primary">OrbitNet-NetCore</h1>
                <p class="lead text-muted">Ejemplo 5: Validación Estricta RegEx y Carga Masiva Transaccional (Commit y Rollback)</p>
                <div class="badge bg-secondary px-3 py-2">Estado: Simulación en Memoria RAM Activa</div>
            </div>

            <!-- Alertas de retroalimentación -->
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @ViewBag.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    @ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row g-4 mb-5">
                <!-- Tarjeta de Carga Masiva -->
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="mb-0 fw-semibold">Carga XML Transaccional</h5>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <p class="text-muted small">Suba un archivo XML. Si al menos uno de los satélites no cumple con los patrones RegEx para ID (SAT-ECU-0000 o SAT-POL-0000) o IP, la carga completa se abortará de forma segura (Rollback).</p>
                            
                            <form asp-action="CargarXml" method="post" enctype="multipart/form-data" class="mt-3">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-secondary">Archivo XML</label>
                                    <input type="file" name="archivoXml" class="form-control" accept=".xml" required />
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-shield-check me-2"></i>Iniciar Ingesta RegEx
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta de Controles -->
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-header bg-dark text-white py-3">
                            <h5 class="mb-0 fw-semibold">Administración y Datos de Prueba</h5>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div class="d-flex gap-2 flex-column">
                                <a href="~/datos_validos.xml" download class="btn btn-outline-success text-start w-100">
                                    <i class="bi bi-file-earmark-check-fill me-2 text-success"></i>Descargar datos_validos.xml (Commit)
                                </a>
                                <a href="~/datos_invalidos.xml" download class="btn btn-outline-warning text-start w-100">
                                    <i class="bi bi-file-earmark-x-fill me-2 text-warning"></i>Descargar datos_invalidos.xml (Rollback)
                                </a>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <form asp-action="Limpiar" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-trash-fill me-2"></i>Purgar Satélites
                                    </button>
                                </form>
                                <form asp-action="LimpiarLogs" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-journal-x me-2"></i>Purgar Logs
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fila de Tablas TDA -->
            <div class="row g-4">
                <!-- Tabla de Satélites -->
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-semibold">Satélites Activos (TDA ListaSatelites)</h6>
                            <span class="badge bg-light text-dark rounded-pill px-3">@Model.Satelites.Tamano</span>
                        </div>
                        <div class="card-body p-3 bg-light">
                            @if (Model.Satelites.EstaVacia)
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-hdd-fill display-6 text-secondary mb-2 d-block"></i>
                                    <p class="mb-0 small">Base de datos de satélites vacía.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                                    <table class="table table-hover align-middle bg-white mb-0 rounded-2 overflow-hidden shadow-sm">
                                        <thead class="table-dark fs-7">
                                            <tr>
                                                <th scope="col" class="px-3 py-2.5">ID</th>
                                                <th scope="col" class="py-2.5">Nombre</th>
                                                <th scope="col" class="py-2.5">Enlace IP</th>
                                            </tr>
                                        </thead>
                                        <tbody class="fs-7">
                                            @foreach (var satelite in Model.Satelites.Recorrer())
                                            {
                                                <tr>
                                                    <td class="px-3 py-2 font-monospace fw-bold text-primary">@satelite.Id</td>
                                                    <td class="py-2 fw-semibold text-dark">@satelite.Nombre</td>
                                                    <td class="py-2"><span class="badge bg-light text-dark border font-monospace">@satelite.EnlaceIP</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tabla de Logs de Auditoría -->
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-semibold">Bitácora Global (TDA LogAuditoria)</h6>
                            <span class="badge bg-light text-dark rounded-pill px-3">@Model.Logs.Tamano</span>
                        </div>
                        <div class="card-body p-3 bg-light">
                            @if (Model.Logs.EstaVacia)
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-text display-6 text-secondary mb-2 d-block"></i>
                                    <p class="mb-0 small">Bitácora de auditoría vacía.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                                    <table class="table table-hover align-middle bg-white mb-0 rounded-2 overflow-hidden shadow-sm">
                                        <thead class="table-dark fs-7">
                                            <tr>
                                                <th scope="col" class="px-3 py-2.5">Timestamp</th>
                                                <th scope="col" class="py-2.5">Tipo</th>
                                                <th scope="col" class="py-2.5">Mensaje</th>
                                            </tr>
                                        </thead>
                                        <tbody class="fs-7">
                                            @foreach (var log in Model.Logs.Recorrer())
                                            {
                                                var filaClase = log.Tipo == "ERROR" ? "table-danger" : "";
                                                var badgeClase = log.Tipo == "ERROR" ? "bg-danger" : "bg-success";
                                                <tr class="@filaClase">
                                                    <td class="px-3 py-2 text-muted font-monospace" style="white-space: nowrap;">@log.Timestamp</td>
                                                    <td class="py-2"><span class="badge @badgeClase text-white">@log.Tipo</span></td>
                                                    <td class="py-2 text-dark font-monospace" style="font-size: 0.8rem;">@log.Mensaje</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
