@model Ejemplo_3.Models.ListaSatelites
@{
    ViewData["Title"] = "Ejemplo 3 - OrbitNet MVC";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Encabezado con diseño moderno -->
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-primary">OrbitNet-NetCore</h1>
                <p class="lead text-muted">Ejemplo 3: Integración del Patrón MVC y Estructuras de Datos Manuales (TDA)</p>
                <div class="badge bg-secondary px-3 py-2">Estado: Simulación en Memoria RAM Activa</div>
            </div>

            <!-- Card principal del simulador -->
            <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-dark text-white px-4 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">Constelación Satelital (Lista Enlazada Simple)</h5>
                    <span class="badge bg-success rounded-pill px-3">@Model.Tamano Satélites</span>
                </div>
                <div class="card-body p-4 bg-light">
                    @if (Model.EstaVacia)
                    {
                        <div class="alert alert-warning text-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            La lista enlazada manual se encuentra vacía en la memoria RAM.
                        </div>
                    }
                    else
                    {
                        <!-- Tabla responsiva -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 bg-white rounded-3 overflow-hidden shadow-sm">
                                <thead class="table-primary text-uppercase fs-6">
                                    <tr>
                                        <th scope="col" class="px-4 py-3 text-secondary">ID Satélite</th>
                                        <th scope="col" class="py-3 text-secondary">Nombre Asignado</th>
                                        <th scope="col" class="py-3 text-secondary">Dirección IP de Enlace</th>
                                        <th scope="col" class="py-3 text-secondary">Descripción Física</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Recorrido secuencial de punteros del TDA usando el iterador personalizado *@
                                    @foreach (var satelite in Model.Recorrer())
                                    {
                                        <tr>
                                            <td class="px-4 py-3 font-monospace fw-bold text-primary">
                                                @satelite.Id
                                            </td>
                                            <td class="py-3 fw-semibold text-dark">
                                                @satelite.Nombre
                                            </td>
                                            <td class="py-3">
                                                <span class="badge bg-info text-dark font-monospace px-2.5 py-1.5">
                                                    @satelite.EnlaceIP
                                                </span>
                                            </td>
                                            <td class="py-3 text-muted fs-7">
                                                @satelite.ObtenerDescripcion()
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="card-footer bg-white text-end px-4 py-3 border-top-0">
                    <small class="text-muted font-monospace">Estructura Física: ListaEnlazadaSimple [Cabeza -> Nodo 1 -> Nodo 2 -> ... -> Null]</small>
                </div>
            </div>

            <!-- Nota informativa de la sesión -->
            <div class="mt-4 text-center">
                <p class="text-muted small">
                    Esta vista Razor recorre de forma directa los punteros de memoria RAM sin intermediarios ni colecciones nativas de .NET.
                </p>
            </div>
        </div>
    </div>
</div>
